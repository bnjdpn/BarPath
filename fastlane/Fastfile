default_platform(:ios)

def load_api_key
  api_key_path = File.join(__dir__, "asc_api_key.json")
  api_key_data = JSON.parse(File.read(api_key_path))
  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] || api_key_data["key_id"],
    issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] || api_key_data["issuer_id"],
    key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"] || api_key_data["key"],
    in_house: false
  )
end

platform :ios do
  # ──────────────────────────────────────────────
  # Testing
  # ──────────────────────────────────────────────

  desc "Run all unit tests"
  lane :test do
    run_tests(
      scheme: "BarPath",
      devices: ["iPhone 17"],
      clean: false,
      code_coverage: true
    )
  end

  # ──────────────────────────────────────────────
  # Screenshots
  # ──────────────────────────────────────────────

  desc "Generate new localized screenshots"
  lane :screenshots do
    capture_screenshots(scheme: "BarPath")
  end

  # ──────────────────────────────────────────────
  # Beta (TestFlight)
  # ──────────────────────────────────────────────

  desc "Push a new beta build to TestFlight"
  lane :beta do
    api_key = load_api_key
    match(type: "appstore", readonly: true)

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key) + 1,
      xcodeproj: "BarPath.xcodeproj"
    )

    build_app(
      scheme: "BarPath",
      configuration: "Release",
      export_method: "app-store"
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    commit_version_bump(
      xcodeproj: "BarPath.xcodeproj",
      message: "build: bump build number for TestFlight"
    )
  end

  # ──────────────────────────────────────────────
  # Release (App Store)
  # ──────────────────────────────────────────────

  desc "Full App Store release: screenshots + metadata + build"
  lane :release do
    api_key = load_api_key

    # 1. Generate screenshots
    UI.message("Generating screenshots...")
    capture_screenshots(scheme: "BarPath")

    # 2. Build the app
    UI.message("Building app...")
    match(type: "appstore", readonly: true)

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key) + 1,
      xcodeproj: "BarPath.xcodeproj"
    )

    build_app(
      scheme: "BarPath",
      configuration: "Release",
      export_method: "app-store"
    )

    # 3. Upload screenshots
    UI.message("Uploading screenshots...")
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      screenshots_path: "#{File.join(__dir__, "..", "app_store_screenshots")}"
    )

    # 4. Upload build + metadata
    UI.message("Uploading build and metadata...")
    upload_to_app_store(
      api_key: api_key,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      run_precheck_before_submit: false
    )

    commit_version_bump(
      xcodeproj: "BarPath.xcodeproj",
      message: "build: bump build number for App Store release"
    )

    UI.success("Release complete! Check App Store Connect.")
  end

  # ──────────────────────────────────────────────
  # Release Quick (without screenshots)
  # ──────────────────────────────────────────────

  desc "Deploy to the App Store without uploading screenshots"
  lane :release_quick do
    api_key = load_api_key
    match(type: "appstore", readonly: true)

    increment_build_number(
      build_number: latest_testflight_build_number(api_key: api_key) + 1,
      xcodeproj: "BarPath.xcodeproj"
    )

    build_app(
      scheme: "BarPath",
      configuration: "Release",
      export_method: "app-store"
    )

    upload_to_app_store(
      api_key: api_key,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      run_precheck_before_submit: false
    )

    commit_version_bump(
      xcodeproj: "BarPath.xcodeproj",
      message: "build: bump build number for App Store release"
    )
  end

  # ──────────────────────────────────────────────
  # Metadata only
  # ──────────────────────────────────────────────

  desc "Upload metadata only (no build, no screenshots)"
  lane :metadata do
    api_key = load_api_key
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      run_precheck_before_submit: false
    )
  end

  # ──────────────────────────────────────────────
  # Screenshots only
  # ──────────────────────────────────────────────

  desc "Upload screenshots only"
  lane :upload_screenshots do
    api_key = load_api_key
    upload_to_app_store(
      api_key: api_key,
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      screenshots_path: "#{File.join(__dir__, "..", "app_store_screenshots")}"
    )
  end
end
