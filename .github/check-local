#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
: "${SCEO_SIM_UDID:?Reserve an iPhone simulator before running studio-ci}"
qa_data=$(mktemp -d "${TMPDIR:-/tmp}/469-BarPath.XXXXXX")
trap 'rm -rf "$qa_data"' EXIT HUP INT TERM
for action in build-for-testing test-without-building; do
  xcodebuild -project BarPath.xcodeproj -scheme BarPath \
    -configuration Debug -destination "platform=iOS Simulator,id=$SCEO_SIM_UDID" \
    -derivedDataPath "$qa_data" \
    -parallel-testing-enabled NO -maximum-concurrent-test-simulator-destinations 1 \
    CODE_SIGNING_ALLOWED=NO "$action"
done
